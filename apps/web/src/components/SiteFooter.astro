---
import type { Locale } from "../lib/locale";
import { translate } from "../lib/translation";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const repo = "https://github.com/sya-ri/spigot-event-list";
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <a class="author" href="https://github.com/sya-ri" translate="no">
      sya-ri
    </a>
    <nav aria-label={locale === "ja" ? "関連リンク" : "Resources"}>
      <a href={repo + "#ai-skill"}>{translate(locale, "AiSkillTitle")}</a>
      <a href={repo + "/blob/master/docs/development.md#i18n"}>
        {translate(locale, "AddNewLanguage")}
      </a>
    </nav>
  </div>
</footer>
