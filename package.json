{
  "name": "spigot-event-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spigot-event-list/web dev",
    "build": "pnpm --filter @spigot-event-list/web build && pnpm --filter @spigot-event-list/api build",
    "preview": "pnpm --filter @spigot-event-list/api preview",
    "test": "tsx --test \"apps/**/*.test.ts\" \"packages/**/*.test.ts\" \"tests/*.test.ts\"",
    "typecheck": "pnpm --filter @spigot-event-list/web check && tsc -p apps/api --noEmit && tsc -p apps/downloader --noEmit && tsc -p packages/catalog --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "benchmark": "tsx scripts/benchmark-search.ts"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@spigot-event-list/catalog": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.23.0"
}
